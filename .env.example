# Meta Ads MCP Server Configuration
# ─────────────────────────────────────────────────────────────────
# Copy to `.env` and fill the values for your deployment.
# Never commit `.env` — it is gitignored.

# ── Public URL of this server (required in production) ─────────
# e.g. https://meta-ads-mcp-xxx.run.app or http://localhost:3000
SERVER_URL=

# ── Meta App credentials (required for OAuth login flow) ──────
# Create an App at developers.facebook.com → Add product "Facebook Login"
# Configure Valid OAuth Redirect URI: <SERVER_URL>/auth/meta/callback
META_APP_ID=
META_APP_SECRET=
# Optional override; auto-derived from SERVER_URL if absent
META_OAUTH_REDIRECT_URI=

# ── Allowlist (at least one source required when META_APP_ID is set) ──
# Only listed identities can complete the Meta login flow.
AUTH_ALLOWED_EMAILS=
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_FB_USER_IDS=

# ── Encryption & sessions ─────────────────────────────────────
# Used to encrypt Meta tokens at rest in Firestore (AES-256-GCM)
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Version embedded in every new ciphertext. Increment during key rotation.
TOKEN_ENCRYPTION_KEY_VERSION=v1
# Optional JSON map used only while completing a rotation, for example:
# TOKEN_ENCRYPTION_OLD_KEYS={"v1":"<64 hex chars>"}
TOKEN_ENCRYPTION_OLD_KEYS=

# Used to sign session cookies (>= 32 chars random)
# Generate with: openssl rand -base64 32
SESSION_COOKIE_SECRET=

# Used to sign MCP OAuth JWTs (>= 32 chars random)
# Generate with: openssl rand -hex 32
OAUTH_SECRET=

# ── Firestore (where encrypted tokens live) ──────────────────
# Defaults to GOOGLE_CLOUD_PROJECT when running on GCP.
# For local dev, point FIRESTORE_EMULATOR_HOST to the emulator.
FIRESTORE_PROJECT_ID=
# FIRESTORE_EMULATOR_HOST=localhost:8085

# Private GCS bucket for tenant-scoped XLSX reports. Keep public access disabled,
# enable Uniform Bucket-Level Access and configure lifecycle/CMEK on the bucket.
REPORTS_GCS_BUCKET=

# Cloud Scheduler / Tasks OIDC identity for the internal reporting worker.
# Audience should be the exact HTTPS URL configured on the scheduled request.
AGENCY_REPORTING_JOBS_ENABLED=false
AGENCY_SCHEDULER_AUDIENCE=
AGENCY_SCHEDULER_SERVICE_ACCOUNT=
# Required immutable numeric `sub` claim to survive service-account recreation.
AGENCY_SCHEDULER_SUBJECT=
# PEM public key used only to verify signed reporting payloads.
AGENCY_REPORTING_JOB_PUBLIC_KEY=
# Optional lease duration (1 second to 15 minutes); default 60000.
AGENCY_REPORTING_LEASE_TTL_MS=60000

# ── Legacy / single-tenant fallbacks (optional) ──────────────
# Never set these in a multi-tenant/OAuth deployment. Startup rejects them.
# They exist only for upstream-compatible, single-operator stdio usage.
META_ACCESS_TOKEN=
# Multi-token JSON: {"agency_a":"EAA...","agency_b":"EAA..."}
META_TOKENS=
# Service-to-service API key (skips OAuth entirely)
MCP_API_KEY=

# ── Apify (Meta Ad Library scraping, optional) ───────────────
# The primary path is per-tenant: each user registers their own token with
# ads_library_register_apify_token and it is stored encrypted in Firestore.
# This env var is only a fallback for stdio / single-operator deployments.
# Get a token at https://console.apify.com/settings/integrations
APIFY_TOKEN=

# ── Server settings ──────────────────────────────────────────
META_API_VERSION=v22.0
MCP_MODE=read_only
ALLOW_LEAD_PII=false
# Required in production multi-tenant mode for shared quotas and breakers.
DISTRIBUTED_RATE_LIMIT_BACKEND=firestore
PORT=3000
LOG_LEVEL=info
NODE_ENV=production
